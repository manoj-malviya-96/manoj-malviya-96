{
	"name": "portfolio",
	"version": "2.0.0",
	"private": true,
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=22"
	},
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"dev": "next dev --turbo",
		"build": "next build",
		"start": "next start",
		"sanitize": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/file-sanitizer.ts",
		"lint:fix": "knip --fix && pnpm sanitize --write --write && biome check --write .",
		"lint": "biome check . && knip --no-progress && knip && pnpm sanitize",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf .next"
	},
	"dependencies": {
		"@manoj-malviya-96/atom": "0.3.4",
		"@tanstack/react-query": "^5.104.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"knip": "^6.38.0",
		"next": "^16.3.6",
		"oxc-parser": "^0.151.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"typescript": "^7.0.2"
	}
}
