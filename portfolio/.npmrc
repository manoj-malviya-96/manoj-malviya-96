# @manoj-malviya-96/atom is published to GitHub Packages, not npmjs.
# GitHub Packages requires an authenticated request even for public packages,
# so NODE_AUTH_TOKEN must be set to a token with read:packages — locally, in
# CI, and in the Vercel project's environment variables.
@manoj-malviya-96:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
